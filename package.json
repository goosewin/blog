{
  "name": "goosewin-blog",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "preview": "next start --port 3000",
    "check": "vp check",
    "lint": "pnpm run lint:package-manager && vp lint",
    "lint:package-manager": "tsx scripts/enforce-pnpm-policy.ts",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vp test",
    "verify:precommit": "pnpm run lint:package-manager && vp check && vp test && next build",
    "newsletter": "bash scripts/send-newsletter.sh",
    "deploy": "pnpm dlx vercel@latest --prod"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@react-email/render": "^2.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^1.0.1",
    "next": "16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.2",
    "resend": "^6.20.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@11.17.0"
}
